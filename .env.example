# Example settings only. Copy to .env and replace with your local values.
# Do not put real passwords, keys, or production URLs in this file.

DATABASE_URL=sqlite:///./data/app.db
SECRET_KEY=replace-with-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=60
CORS_ORIGINS=http://127.0.0.1:3000
RATE_LIMIT_PER_MINUTE=60
SUMMARY_CACHE_TTL_SECONDS=60
INGEST_LOG_PATH=logs/ingestion.log
REQUEST_LOG_PATH=logs/requests.log

# Local seed script only (scripts/seed_users.py). Fake values — change after copy.
SEED_ADMIN_PASSWORD=change-me-admin
SEED_SURVEYOR_PASSWORD=change-me-surveyor
